    "write_owners": {
      "align.apply": "kb.manage",
      "manage.init": "kb.build",
      "manage.config.set": "kb.build",
      "registry.set": "kb.build",
      "record.add": "kb.ingest",
      "record.edit": "kb.manage",
      "record.delete": "kb.manage"
