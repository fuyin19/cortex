{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:cortex:schema:ingest-proposal:2.0.0","type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","artifact_id","digest","parents","context_id","items","link_policy","source_rewrites","publications"],
  "properties":{
    "schema_id":{"const":"urn:cortex:schema:ingest-proposal:2.0.0"},"schema_version":{"const":"2.0.0"},"artifact_id":{"type":"string","pattern":"^ingest-proposal@[a-f0-9]{64}$"},"digest":{"$ref":"#/$defs/sha"},
    "parents":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/contextRef"}},"context_id":{"type":"string","pattern":"^ingest-context@[a-f0-9]{64}$"},
    "items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/item"}},"link_policy":{"enum":["reject","sanitize"]},
    "source_rewrites":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/rewrite"}},"publications":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/publication"}}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},"prefixed":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "contextRef":{"type":"object","additionalProperties":false,"required":["schema_id","artifact_id","digest"],"properties":{"schema_id":{"const":"urn:cortex:schema:ingest-context:2.0.0"},"artifact_id":{"type":"string","pattern":"^ingest-context@[a-f0-9]{64}$"},"digest":{"$ref":"#/$defs/sha"}}},
    "assignments":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9_]*$"},"additionalProperties":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"}},
    "item":{"type":"object","additionalProperties":false,"required":["source_id","assignments"],"properties":{"source_id":{"type":"string","pattern":"^urn:sha256:[a-f0-9]{64}$"},"assignments":{"$ref":"#/$defs/assignments"}}},
    "transformation":{"type":"object","additionalProperties":false,"required":["ordinal","kind","destination","start_byte","end_byte","before","after"],"properties":{"ordinal":{"type":"integer","minimum":1},"kind":{"enum":["prose","image","attachment"]},"destination":{"type":"string"},"start_byte":{"type":"integer","minimum":0},"end_byte":{"type":"integer","minimum":0},"before":{"type":"string"},"after":{"type":"string"}}},
    "rewrite":{"type":"object","additionalProperties":false,"required":["source_id","input_body_digest","output_body_digest","transformations"],"properties":{"source_id":{"type":"string","pattern":"^urn:sha256:[a-f0-9]{64}$"},"input_body_digest":{"$ref":"#/$defs/prefixed"},"output_body_digest":{"$ref":"#/$defs/prefixed"},"transformations":{"type":"array","items":{"$ref":"#/$defs/transformation"}}}},
    "publication":{"type":"object","additionalProperties":false,"required":["source_id","path","content_b64","content_digest"],"properties":{"source_id":{"type":"string","pattern":"^urn:sha256:[a-f0-9]{64}$"},"path":{"type":"string","pattern":"^references/[^/]+\\.md$"},"content_b64":{"type":"string","pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$","contentEncoding":"base64"},"content_digest":{"$ref":"#/$defs/sha"}}}
  }
}
