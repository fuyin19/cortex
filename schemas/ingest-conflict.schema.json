{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:cortex:schema:ingest-conflict:2.0.0","type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","artifact_id","digest","parents","context_ref","proposal_ref","path","existing_digest","proposed_digest","diff"],
  "properties":{
    "schema_id":{"const":"urn:cortex:schema:ingest-conflict:2.0.0"},"schema_version":{"const":"2.0.0"},"artifact_id":{"type":"string","pattern":"^ingest-conflict@[a-f0-9]{64}$"},"digest":{"$ref":"#/$defs/sha"},
    "parents":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/ref"}},"context_ref":{"$ref":"#/$defs/contextRef"},"proposal_ref":{"$ref":"#/$defs/proposalRef"},
    "path":{"type":"string","pattern":"^references/[^/]+\\.md$"},"existing_digest":{"$ref":"#/$defs/sha"},"proposed_digest":{"$ref":"#/$defs/sha"},"diff":{"type":"string","minLength":1}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "ref":{"type":"object","additionalProperties":false,"required":["schema_id","artifact_id","digest"],"properties":{"schema_id":{"type":"string","pattern":"^urn:cortex:schema:"},"artifact_id":{"type":"string"},"digest":{"$ref":"#/$defs/sha"}}},
    "contextRef":{"type":"object","additionalProperties":false,"required":["schema_id","artifact_id","digest"],"properties":{"schema_id":{"const":"urn:cortex:schema:ingest-context:2.0.0"},"artifact_id":{"type":"string","pattern":"^ingest-context@[a-f0-9]{64}$"},"digest":{"$ref":"#/$defs/sha"}}},
    "proposalRef":{"type":"object","additionalProperties":false,"required":["schema_id","artifact_id","digest"],"properties":{"schema_id":{"const":"urn:cortex:schema:ingest-proposal:2.0.0"},"artifact_id":{"type":"string","pattern":"^ingest-proposal@[a-f0-9]{64}$"},"digest":{"$ref":"#/$defs/sha"}}}
  }
}
