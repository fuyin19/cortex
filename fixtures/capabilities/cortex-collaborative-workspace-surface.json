{
  "version": "1.1.1",
  "distribution": "cortex-collaborative-workspace",
  "import": "cortex_collaborative_workspace",
  "runner": "run_collaborative_workspace.py",
  "routes": [
    "collaborative_workspace.prepare",
    "collaborative_workspace.status",
    "collaborative_workspace.validate"
  ],
  "contracts": [
    "collaborative-workspace-envelope/v1",
    "agent-workbench-envelope/v1"
  ],
  "skill": "cortex",
  "role": "collaborative-workspace",
  "adapter": "skills/cortex/scripts/collaborative-workspace",
  "invocation_policy": "explicit-only",
  "provider_routes": [
    "knowledge-unit-copy",
    "file-conversion",
    "markdown-conversion"
  ],
  "required_environment": [
    "CORTEX_PYTHON"
  ],
  "conditional_provider_environment": {
    "file-conversion": [
      "FILE_CONVERSION_RUNNER",
      "FILE_CONVERSION_CONFIG"
    ],
    "markdown-conversion": [
      "MARKDOWN_CONVERSION_RUNNER",
      "MARKDOWN_CONVERSION_CONFIG"
    ]
  },
  "core_binding": {
    "skill_id": "anti-entropy-core",
    "default": "<cortex-skill-parent>/anti-entropy-core/scripts/knowledge_unit_runner.py",
    "override": "ANTI_ENTROPY_CORE_RUNNER",
    "override_present_invalid": "fail-closed",
    "abi": "anti-entropy-core.runner/v1",
    "exact_version": "1.2.1",
    "preflight_timeout_seconds": 30,
    "operation_scope": "one fixed runner; converter subprocesses receive the same path"
  }
}
