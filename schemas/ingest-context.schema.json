{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:cortex:schema:ingest-context:2.0.0",
  "type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","artifact_id","digest","parents","bundle_identity","base_tree_digest","tag_schema_digest","sources"],
  "properties":{
    "schema_id":{"const":"urn:cortex:schema:ingest-context:2.0.0"},"schema_version":{"const":"2.0.0"},
    "artifact_id":{"type":"string","pattern":"^ingest-context@[a-f0-9]{64}$"},"digest":{"$ref":"#/$defs/sha"},
    "parents":{"type":"array","maxItems":0},"bundle_identity":{"$ref":"#/$defs/sha"},"base_tree_digest":{"$ref":"#/$defs/sha"},"tag_schema_digest":{"$ref":"#/$defs/sha"},
    "sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},"prefixed":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"tag":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "assignments":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9_]*$"},"additionalProperties":{"$ref":"#/$defs/tag"}},
    "candidate":{"type":"object","additionalProperties":false,"required":["tag","label","aliases"],"properties":{"tag":{"$ref":"#/$defs/tag"},"label":{"type":"string","minLength":1},"aliases":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},
    "unresolved":{"type":"object","additionalProperties":false,"required":["dimension","candidates"],"properties":{"dimension":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"candidates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidate"}}}},
    "source":{"type":"object","additionalProperties":false,"required":["source_id","source_path","source_digest","body_digest","title","timestamp","resolved_assignments","unresolved_dimensions"],"properties":{"source_id":{"type":"string","pattern":"^urn:sha256:[a-f0-9]{64}$"},"source_path":{"type":"string","minLength":1},"source_digest":{"$ref":"#/$defs/prefixed"},"body_digest":{"$ref":"#/$defs/prefixed"},"title":{"type":"string","minLength":1},"timestamp":{"oneOf":[{"type":"string","format":"date"},{"type":"string","format":"date-time"}]},"resolved_assignments":{"$ref":"#/$defs/assignments"},"unresolved_dimensions":{"type":"array","items":{"$ref":"#/$defs/unresolved"}}}}
  }
}
