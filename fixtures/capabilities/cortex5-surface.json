{
  "distribution": "cortex-record-kb",
  "import": "cortex",
  "version": "5.1.0",
  "routes": [
    "registry.show",
    "registry.validate",
    "registry.resolve",
    "registry.set",
    "manage.init",
    "manage.status",
    "manage.validate",
    "manage.config.show",
    "manage.config.set",
    "record.add",
    "record.edit"
  ],
  "profiles": [
    "record-schema.json",
    "tags.json",
    "layout.json"
  ],
  "record_profile_version": 1,
  "tag_profile_version": 2,
  "layout_profile_version": 2,
  "unit_name_strategies": [
    "title-slug",
    "partition-title-date"
  ],
  "registry_version": 1,
  "root_lock": ".cortex.lock",
  "record_operand": "<partition-tag>/<unit-folder>",
  "skill_count": 2
}
