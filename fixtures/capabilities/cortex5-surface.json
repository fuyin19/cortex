{
  "distribution": "cortex-record-kb",
  "import": "cortex",
  "version": "5.0.0",
  "routes": [
    "manage.init",
    "manage.status",
    "manage.validate",
    "manage.config.show",
    "manage.config.set",
    "record.add",
    "record.edit"
  ],
  "profiles": [
    "record-schema.json",
    "tags.json",
    "layout.json"
  ],
  "tag_profile_version": 2,
  "layout_profile_version": 2,
  "record_operand": "<partition-tag>/<unit-folder>",
  "skill_count": 2
}
